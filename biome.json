{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": [
      "node_modules/**",
      "**/node_modules/**",
      "public/talks/**",
      "quartz/**",
      ".scratch/**",
      ".tmp-ingest/**",
      ".worktrees/**",
      ".playwright-mcp/**",
      ".agents/**",
      ".claude/**",
      "_lint/**",
      "public/exams/**/*.json",
      "public/questions.json",
      "raw/**/*.json",
      "public/dungeon/public/data/**",
      "public/dungeon/dist/**",
      "dashboard.md",
      "public/dungeon/public/assets/**",
      ".obsidian/**",
      ".mcp.json",
      "certs/**/*.json",
      "**/package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off",
        "useOptionalChain": "warn"
      },
      "style": {
        "useTemplate": "warn",
        "useNodejsImportProtocol": "warn",
        "useSingleVarDeclarator": "warn",
        "useExponentiationOperator": "warn",
        "noNonNullAssertion": "warn",
        "noUnusedTemplateLiteral": "warn",
        "noParameterAssign": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noAssignInExpressions": "warn"
      },
      "performance": {
        "noDelete": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  }
}
