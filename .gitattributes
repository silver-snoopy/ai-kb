# Force LF line endings for all text files.
# Without this, Windows autocrlf converts to CRLF on checkout,
# which trips Biome (which is configured to expect LF).
* text=auto eol=lf

# Binary files (never alter)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.pdf binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.wav binary
